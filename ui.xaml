<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dsh 启动器" Height="780" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1B1B1F" Foreground="#E6E6E6"
        FontFamily="Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#232329"/>
    <SolidColorBrush x:Key="LineBrush" Color="#3A3A42"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9A9AA8"/>

    <Style TargetType="Button">
      <Setter Property="Background" Value="#2C2C34"/>
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="BorderBrush" Value="#43434F"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#3A3A46"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#4A4A5A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#2E6FB7"/>
      <Setter Property="BorderBrush" Value="#3D82CE"/>
    </Style>

    <Style TargetType="ListView">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="#2C2C34"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style TargetType="ListViewItem">
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
              <GridViewRowPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2E2E38"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2F5D8A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#2C2C34"/>
      <Setter Property="Foreground" Value="#1B1B1F"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#16161A"/>
      <Setter Property="Foreground" Value="#C8C8D0"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E6E6E6"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="190"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Vertical">
          <TextBlock Text="dsh 启动器" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock x:Name="txtSubtitle" Text="多版本 · 独立配置 · 网页打开"
                     Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="lblLatest" Text="最新版本：未检查"
                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button x:Name="btnCheckUpdate" Content="检查更新" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.2*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="1*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1" CornerRadius="8" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnStart" Content="启动" Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="btnStop" Content="停止"/>
            <Button x:Name="btnOpen" Content="打开网页"/>
            <Button x:Name="btnAdd" Content="新增实例"/>
            <Button x:Name="btnAddSource" Content="添加源码"/>
            <Button x:Name="btnRemove" Content="删除"/>
            <Button x:Name="btnImport" Content="导入本机"/>
          </StackPanel>

          <ListView Grid.Row="1" x:Name="lstInstances" SelectionMode="Single">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="名称" Width="130" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="dsh 版本" Width="140" DisplayMemberBinding="{Binding Version}"/>
                <GridViewColumn Header="端口" Width="60" DisplayMemberBinding="{Binding Port}"/>
                <GridViewColumn Header="状态" Width="110" DisplayMemberBinding="{Binding Status}"/>
                <GridViewColumn Header="DSH_HOME" Width="330" DisplayMemberBinding="{Binding Home}"/>
              </GridView>
            </ListView.View>
          </ListView>

          <TextBlock Grid.Row="2" x:Name="txtHint" Margin="2,10,0,0" FontSize="12"
                     Foreground="{StaticResource MutedBrush}"
                     Text="选中实例后点【启动】，启动器会在独立 DSH_HOME 下运行 dsh web，就绪后自动打开浏览器。"/>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1" CornerRadius="8" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="已安装版本" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <ListView Grid.Row="1" x:Name="lstVersions" Height="150" SelectionMode="Single">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="版本" Width="150" DisplayMemberBinding="{Binding Version}"/>
                <GridViewColumn Header="来源" Width="110" DisplayMemberBinding="{Binding Source}"/>
              </GridView>
            </ListView.View>
          </ListView>

          <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="安装新版本" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ComboBox x:Name="cmbAvailable" Height="30"/>
            <TextBlock Text="安装到 versions\ 目录，不影响全局 npm 与 nvm。"
                       Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>

          <Button Grid.Row="3" x:Name="btnInstall" Content="下载并安装" Margin="0,12,0,0"/>
          <TextBlock Grid.Row="4" x:Name="txtInstallState" Text="" FontSize="11"
                     Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,6">
      <TextBlock Text="运行日志" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock x:Name="txtLogPath" Text="" Foreground="{StaticResource MutedBrush}"
                 FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
    </StackPanel>

    <Border Grid.Row="3" Background="#141418" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1" CornerRadius="8" Padding="2">
      <TextBox x:Name="txtLog" IsReadOnly="True" BorderThickness="0" Background="Transparent"
               Foreground="#B9C7D6" FontFamily="Consolas" FontSize="12"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               TextWrapping="NoWrap" AcceptsReturn="True"/>
    </Border>
  </Grid>
</Window>