<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="dsh-luncher" Height="880" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.Resources>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="1" Direction="270"
                      Color="#000000" Opacity="0.07"/>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>

    <Style TargetType="ListView">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="{DynamicResource HeaderRowBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                    CornerRadius="5" Margin="2,1">
              <GridViewRowPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource LogBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource LogTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="2,0,0,10"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="200"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20,16" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="dsh-luncher" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock x:Name="txtSubtitle" Text="多版本 · 独立配置 · 网页打开"
                     Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="btnAppUpdate" Content="v0.0.0" Style="{StaticResource GhostButton}" Margin="0,0,12,0"/>
          <TextBlock x:Name="lblLatest" Text="最新版本：未检查"
                     Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <Button x:Name="btnCheckUpdate" Content="检查更新" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
          <Button x:Name="btnTheme" Content="深色" Style="{StaticResource GhostButton}" Margin="0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.2*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="1*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="btnStart" Content="启动" Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="btnStop" Content="停止"/>
            <Button x:Name="btnOpen" Content="打开网页"/>
            <Button x:Name="btnAdd" Content="新增实例"/>
            <Button x:Name="btnAddSource" Content="添加源码"/>
            <Button x:Name="btnEditPort" Content="改端口"/>
            <Button x:Name="btnRemove" Content="删除"/>
            <Button x:Name="btnImport" Content="导入本机" Margin="0"/>
          </StackPanel>

          <ListView Grid.Row="1" x:Name="lstInstances" SelectionMode="Single">
            <ListView.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="menuEditPort" Header="修改端口…"/>
                <MenuItem x:Name="menuToggleShare" Header="切换共享配置"/>
                <MenuItem x:Name="menuOpenFolder" Header="打开实例目录"/>
              </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
              <GridView>
                <GridViewColumn Header="名称" Width="130" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="dsh 版本" Width="140" DisplayMemberBinding="{Binding Version}"/>
                <GridViewColumn Header="端口" Width="66" DisplayMemberBinding="{Binding Port}"/>
                <GridViewColumn Header="状态" Width="96" DisplayMemberBinding="{Binding Status}"/>
                <GridViewColumn Header="DSH_HOME" Width="340" DisplayMemberBinding="{Binding Home}"/>
              </GridView>
            </ListView.View>
          </ListView>

          <TextBlock Grid.Row="2" x:Name="txtHint" Margin="2,12,0,0" TextWrapping="Wrap"
                     Style="{StaticResource MutedText}"
                     Text="选中实例后点【启动】，启动器会在独立 DSH_HOME 下运行 dsh web，就绪后自动打开浏览器。"/>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="已安装版本" Style="{StaticResource SectionTitle}"/>
          <ListView Grid.Row="1" x:Name="lstVersions" Height="120" SelectionMode="Single">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="版本" Width="170" DisplayMemberBinding="{Binding Display}"/>
                <GridViewColumn Header="来源" Width="110" DisplayMemberBinding="{Binding Source}"/>
              </GridView>
            </ListView.View>
          </ListView>

          <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="下载源" Style="{StaticResource SectionTitle}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ComboBox Grid.Column="0" x:Name="cmbRegistry" Height="32" IsEditable="True" Margin="0"/>
              <Button Grid.Column="1" x:Name="btnTestRegistry" Content="测速"
                      Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
            </Grid>
            <TextBlock x:Name="txtRegistryHint" Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>

          <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="安装新版本" Style="{StaticResource SectionTitle}"/>
            <ComboBox x:Name="cmbAvailable" Height="32"/>
            <TextBlock Text="安装到 versions\ 目录，不影响全局 npm 与 nvm。"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>

          <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="btnInstall" Content="下载并安装" Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="btnRemoveVersion" Content="删除版本" Margin="0"/>
          </StackPanel>

          <TextBlock Grid.Row="5" x:Name="txtInstallState" Text="" Style="{StaticResource MutedText}"
                     Margin="0,10,0,0" TextWrapping="Wrap"/>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,14,0,8">
      <TextBlock Text="运行日志" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock x:Name="txtLogPath" Text="" Style="{StaticResource MutedText}"
                 VerticalAlignment="Center" Margin="12,0,0,0"/>
    </StackPanel>

    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="2">
      <TextBox x:Name="txtLog" IsReadOnly="True" BorderThickness="0" Background="Transparent"
               Foreground="{DynamicResource LogTextBrush}" FontFamily="Consolas" FontSize="12"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               TextWrapping="NoWrap" AcceptsReturn="True"/>
    </Border>
  </Grid>
</Window>